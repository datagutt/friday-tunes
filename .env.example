# Same Spotify app as spotify-mcp-server. The redirect URI must be registered
# on the app in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER=datagutt

# Optional. https://genius.com/api-clients (client access token)
GENIUS_ACCESS_TOKEN=

# Optional overrides
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=bge-m3
# SQLITE_LIB=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib
# FRIDAY_TUNES_DATA_DIR=
